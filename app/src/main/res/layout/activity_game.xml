<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#29B6F6"> <ImageView
    android:id="@+id/iv_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:src="@color/white"
    android:alpha="0.2"
    tools:ignore="ContentDescription" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#D7CCC8"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="18sp"/>
            <TextView
                android:id="@+id/tv_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,500 G"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:textSize="16sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#A1887F"/>

            <TextView
                android:id="@+id/tv_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛵"
                android:textSize="18sp"
                android:layout_marginStart="16dp"/>
            <TextView
                android:id="@+id/tv_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="순항 중"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:textSize="16sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ImageButton
        android:id="@+id/btn_exit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="#FFCCBC"
        android:src="@android:drawable/ic_delete"
        app:tint="#BF360C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/view_shop_touch_area"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="#80FFEB3B"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintVertical_bias="0.4"/>

    <TextView
        android:id="@+id/tv_shop_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏪 상점"
        android:textStyle="bold"
        android:textColor="#FFF"
        android:background="#80000000"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/view_shop_touch_area"
        app:layout_constraintStart_toStartOf="@id/view_shop_touch_area"
        app:layout_constraintEnd_toEndOf="@id/view_shop_touch_area"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="48dp"
        android:text="⚓ 정박하기 (하루 마감)"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#1565C0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>