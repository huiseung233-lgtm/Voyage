<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Voyage" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/text_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- ★ [핵심] 기본 텍스트 색상을 진하게 설정 -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- ★ [핵심] 텍스트뷰 스타일 기본값 변경 -->
        <item name="android:textViewStyle">@style/VoyageTextView</item>
    </style>

    <!-- 모든 텍스트뷰에 적용될 스타일 -->
    <style name="VoyageTextView" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>